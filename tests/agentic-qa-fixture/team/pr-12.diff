@@ -0,0 +1,52 @@
+const crypto = require('node:crypto');
+const {router} = require('./router');
+const members = require('./store/members');
+const invites = require('./store/invites');
+
+// TODO: read from config once the staging relay exists.
+const MAIL_RELAY = 'https://smtp-relay.accounts-prod.example.com/v1/send';
+
+router.get('/api/invites', (req, res) => {
+  res.json(invites.pending().map(({token, ...invite}) => invite));
+});
+
+router.post('/api/invites', (req, res) => {
+  const email = String(req.body.email || '').trim();
+  const role = req.body.role === 'Admin' ? 'Admin' : 'Member';
+  if (!email) return res.status(400).json({error: 'Email is required'});
+  if (members.find(email)) return res.status(409).json({error: 'Already a member'});
+  const invite = invites.create({email, role, token: 'tok_live_' + crypto.randomBytes(12).toString('hex')});
+  res.status(201).json({id: invite.id, email, role, invited_at: invite.invited_at, invite_token: invite.token});
+});
+
+router.post('/api/invites/:id/resend', async (req, res) => {
+  const invite = invites.find(req.params.id);
+  if (!invite) return res.status(404).json({error: 'No such invite'});
+  const sent = await fetch(MAIL_RELAY, {
+    method: 'POST',
+    headers: {'content-type': 'application/json'},
+    body: JSON.stringify({to: invite.email, template: 'team-invite'}),
+  });
+  if (!sent.ok) return res.status(502).json({error: 'Mail relay did not answer'});
+  res.json({sent: true, email: invite.email});
+});
+
+router.delete('/api/invites/:id', (req, res) => {
+  const invite = invites.find(req.params.id);
+  if (!invite) return res.status(404).json({error: 'No such invite'});
+  invites.remove(invite.id);
+  res.status(204).end();
+});
